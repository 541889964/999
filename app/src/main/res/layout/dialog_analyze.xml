<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp"
        android:background="@drawable/dialog_panel">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <View android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/halo_ring" />
                <View android:layout_width="30dp" android:layout_height="30dp"
                    android:layout_gravity="center" android:background="@drawable/halo_core" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView android:id="@+id/tv_dlg_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="分析好了" android:textColor="@color/txt_primary"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_dlg_sub"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="找好了最快的路"
                    android:textColor="@color/txt_secondary" android:textSize="@dimen/text_meta" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="12dp" android:background="@color/divider" />
        <TextView android:id="@+id/tv_dlg_type"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/txt_primary" android:textSize="@dimen/text_body" />
        <TextView android:id="@+id/tv_dlg_size"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/txt_secondary"
            android:textSize="@dimen/text_meta" />
        <TextView android:id="@+id/tv_dlg_best"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="#FF52C7FF"
            android:textSize="@dimen/text_label" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="换条路试试"
            android:textColor="@color/txt_secondary" android:textSize="@dimen/text_meta" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_strategy"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:maxHeight="280dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_cancel"
                style="@style/TextButton"
                android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="先不下" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_start"
                android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1.4" android:layout_marginStart="8dp"
                android:text="开始" android:textAllCaps="false"
                app:backgroundTint="#FF52C7FF" app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
