<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:background="@color/primary">

        <ImageButton android:id="@+id/btn_back" android:layout_width="42dp" android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous" android:contentDescription="后退" />

        <EditText android:id="@+id/et_web_url"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:background="@drawable/nav_bg"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:hint="搜索或输入网址" android:textSize="13sp"
            android:textColor="@color/white" android:textColorHint="#CCFFFFFF"
            android:inputType="textUri" android:imeOptions="actionGo" android:maxLines="1" />

        <ImageButton android:id="@+id/btn_forward" android:layout_width="42dp" android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next" android:contentDescription="前进" />

        <ImageButton android:id="@+id/btn_refresh" android:layout_width="42dp" android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate" android:contentDescription="刷新" />
    </LinearLayout>

    <ProgressBar android:id="@+id/web_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:progressTint="@color/primary" android:visibility="gone" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/web_view"
            android:layout_width="match_parent" android:layout_height="match_parent" />

        <FrameLayout android:id="@+id/web_error"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#F5FFFFFF" android:visibility="gone">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="网页打不开" android:textColor="@color/on_surface"
                    android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_web_err_msg"
                    android:layout_width="260dp" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center"
                    android:textColor="@color/on_surface_2" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_web_retry"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="重试"
                    android:textAllCaps="false" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
