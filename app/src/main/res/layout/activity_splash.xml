<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/splash_bg_gradient">

    <com.dlmaster.view.ParticleView
        android:id="@+id/splash_particles"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0.7" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical" android:gravity="center">

        <FrameLayout android:layout_width="160dp" android:layout_height="160dp">
            <View android:id="@+id/splash_glow"
                android:layout_width="160dp" android:layout_height="160dp"
                android:background="@drawable/halo_core" />
            <ImageView android:id="@+id/iv_logo"
                android:layout_width="104dp" android:layout_height="104dp"
                android:layout_gravity="center"
                android:src="@drawable/app_logo_hd"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView android:id="@+id/tv_brand"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/app_name"
            android:textColor="@color/white" android:textSize="28sp"
            android:letterSpacing="0.18" android:textStyle="bold"
            android:shadowColor="#66000000" android:shadowDx="0"
            android:shadowDy="2" android:shadowRadius="10" />

        <TextView android:id="@+id/tv_slogan"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="找最快的路 · 一直免费"
            android:textColor="#CCFFFFFF" android:textSize="12sp"
            android:letterSpacing="0.25" />

        <!-- 加载进度条 -->
        <ProgressBar android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp" android:layout_height="2dp"
            android:layout_marginTop="60dp"
            android:max="100" android:progress="0"
            android:progressTint="#FFE8A0F8"
            android:progressBackgroundTint="#33FFFFFF" />

        <!-- 当前加载状态文字 -->
        <TextView android:id="@+id/tv_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="准备启动…"
            android:textColor="#B3FFFFFF" android:textSize="12sp"
            android:letterSpacing="0.05" />
    </LinearLayout>
</FrameLayout>
