<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/splash_bg_gradient">
    <com.dlmaster.view.ParticleView
        android:id="@+id/splash_particles"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0.9" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
        <FrameLayout android:layout_width="140dp" android:layout_height="140dp">
            <View android:id="@+id/splash_glow"
                android:layout_width="140dp" android:layout_height="140dp"
                android:background="@drawable/halo_core" />
            <ImageView android:id="@+id/iv_logo"
                android:layout_width="96dp" android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@drawable/app_logo_hd"
                android:contentDescription="@null" />
        </FrameLayout>
        <TextView android:id="@+id/tv_brand"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="@string/app_name"
            android:textColor="@color/white" android:textSize="26sp"
            android:letterSpacing="0.18" android:textStyle="bold"
            android:shadowColor="#66000000" android:shadowDx="0"
            android:shadowDy="2" android:shadowRadius="8" />
        <TextView android:id="@+id/tv_slogan"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="找最快的路 · 一直免费"
            android:textColor="#E6FFFFFF" android:textSize="12sp"
            android:letterSpacing="0.25" />
    </LinearLayout>
</FrameLayout>
