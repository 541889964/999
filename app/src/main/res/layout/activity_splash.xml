<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/primary">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
        <ImageView android:id="@+id/iv_logo" android:layout_width="120dp" android:layout_height="120dp"
            android:src="@drawable/app_logo_hd" android:contentDescription="@null" />
        <TextView android:id="@+id/tv_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/app_name"
            android:textColor="@color/white" android:textSize="26sp"
            android:letterSpacing="0.15" android:textStyle="bold" />
        <TextView android:id="@+id/tv_slogan" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="帮您找最快的路 · 一直免费"
            android:textColor="#CCFFFFFF" android:textSize="12sp" android:letterSpacing="0.2" />
    </LinearLayout>
</FrameLayout>
