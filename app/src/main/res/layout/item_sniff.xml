<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="10dp"
        android:background="@drawable/sniff_item_selector">
        <TextView android:id="@+id/tv_sniff_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="middle"
            android:textColor="@color/txt_primary" android:textSize="@dimen/text_body_sm" android:textStyle="bold" />
        <TextView android:id="@+id/tv_sniff_ext"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/txt_secondary" android:textSize="@dimen/text_meta" />
    </LinearLayout>
</FrameLayout>
