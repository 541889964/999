<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp"
        android:background="@drawable/sniff_item_selector">
        <TextView android:id="@+id/tv_sniff_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="middle"
            android:textColor="@color/txt_primary" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_sniff_ext"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/txt_secondary" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
