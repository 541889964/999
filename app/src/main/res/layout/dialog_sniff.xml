<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp"
        android:background="@drawable/dialog_panel">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="抓到这些链接" android:textColor="@color/txt_primary"
            android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_sniff_count"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/txt_secondary"
            android:textSize="@dimen/text_meta" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_sniff"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:maxHeight="360dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_sniff_close"
            android:layout_width="match_parent" android:layout_height="42dp"
            android:layout_marginTop="12dp" android:text="关闭"
            android:textAllCaps="false" app:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>
</FrameLayout>
