<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 基础层:半透明白 -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135"
                android:startColor="#40FFFFFF"
                android:centerColor="#28FFFFFF"
                android:endColor="#18FFFFFF" />
            <corners android:radius="24dp" />
            <stroke android:width="1.2dp" android:color="#60FFFFFF" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
